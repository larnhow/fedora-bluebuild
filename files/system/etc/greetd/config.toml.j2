
# Managed by Ansible
# greetd + tuigreet (Gruvbox Dark)

[terminal]
vt = 1

[default_session]
user = "greetd"
command = "tuigreet --time --greeting "Welcome back" | quote }} --remember --remember-user-session --sessions /usr/share/wayland-sessions --cmd niri-session --width 58 --container-padding 2 | quote }}"

